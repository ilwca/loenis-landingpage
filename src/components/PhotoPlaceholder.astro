---
/**
 * Espaço reservado para foto real de serviço.
 * Quando a foto existir: coloque o arquivo em src/assets/fotos/ e passe `src`
 * (um import de imagem) — o componente troca o placeholder por <Image> otimizado.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';

interface Props {
  caption: string;
  src?: ImageMetadata;
  ratio?: '4/3' | '3/2' | '1/1' | '4/5' | '16/9';
  eager?: boolean;
  showCaption?: boolean;
}
const { caption, src, ratio = '4/3', eager = false, showCaption = true } = Astro.props;
---
<figure class="photo" style={`--ratio:${ratio}`}>
  {src ? (
    <Image src={src} alt={caption} widths={[480, 800, 1200]} sizes="(min-width: 900px) 50vw, 100vw" loading={eager ? 'eager' : 'lazy'} />
  ) : (
    <div class="ph" role="img" aria-label={`Foto em breve: ${caption}`}>
      <Icon name="image" size={28} />
      <span class="t-label">Foto em breve</span>
    </div>
  )}
  {showCaption && <figcaption class="t-caption">{caption}</figcaption>}
</figure>

<style>
  .photo { display: grid; gap: var(--space-2); }
  .photo :global(img), .ph {
    width: 100%;
    aspect-ratio: var(--ratio);
    border-radius: var(--radius-lg);
    object-fit: cover;
  }
  .ph {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: var(--space-2);
    background: var(--surface-raised);
    border: 1px dashed var(--line);
    color: var(--ink-muted);
  }
</style>
