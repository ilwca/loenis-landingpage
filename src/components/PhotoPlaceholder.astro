---
/**
 * Foto quadrada (1:1) de serviço, ou um espaço reservado "Foto em breve" quando não há `src`.
 * `src` vem de foto('nome') (src/config/fotos.ts): o navegador baixa a versão
 * desktop (1024px) a partir de 900px de largura e a mobile (320px) abaixo disso.
 */
import type { Foto } from '../config/fotos';
import Icon from './Icon.astro';

interface Props {
  caption: string;
  src?: Foto;
  eager?: boolean;
  showCaption?: boolean;
}
const { caption, src, eager = false, showCaption = true } = Astro.props;
---
<figure class="photo">
  {src ? (
    <picture>
      <source media="(min-width: 900px)" srcset={src.desktop.src} width={src.desktop.width} height={src.desktop.height} type="image/webp" />
      <img
        src={src.mobile.src} width={src.mobile.width} height={src.mobile.height} alt={caption}
        loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} decoding="async"
      />
    </picture>
  ) : (
    <div class="ph" role="img" aria-label={`Foto em breve: ${caption}`}>
      <Icon name="image" size={28} />
      <span class="t-label">Foto em breve</span>
    </div>
  )}
  {showCaption && <figcaption class="t-caption">{caption}</figcaption>}
</figure>

<style>
  /* min-width: 0 impede que a largura nativa da foto estique colunas de grid */
  .photo { display: grid; gap: var(--space-2); min-width: 0; }
  .photo picture { display: block; min-width: 0; }
  .photo :global(img), .ph {
    width: 100%;
    /* Sem isto, o atributo height (1024/320) vira altura fixa e a foto fica esticada na vertical */
    height: auto;
    aspect-ratio: 1 / 1; /* Sempre quadrada, seja qual for a resolução da foto */
    border-radius: var(--radius-lg);
    object-fit: cover;
  }
  .ph {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: var(--space-2);
    background: var(--surface-raised);
    border: 1px dashed var(--line);
    color: var(--ink-muted);
  }
</style>
