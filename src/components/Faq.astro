---
interface Props { items: { q: string; a: string }[] }
const { items } = Astro.props;
---
<div class="faq">
  {items.map((item) => (
    <details>
      <summary class="t-body-strong">{item.q}</summary>
      <p>{item.a}</p>
    </details>
  ))}
</div>

<style>
  .faq { border-top: 1px solid var(--line); max-width: 760px; }
  details { border-bottom: 1px solid var(--line); }
  summary {
    list-style: none; cursor: pointer;
    display: flex; justify-content: space-between; align-items: center; gap: var(--space-4);
    padding-block: var(--space-4);
    min-height: 56px;
  }
  summary::-webkit-details-marker { display: none; }
  summary::after {
    content: ''; flex: none; width: 10px; height: 10px;
    border-right: 2px solid var(--ink); border-bottom: 2px solid var(--ink);
    transform: rotate(45deg) translateY(-3px); transition: transform 0.15s;
  }
  details[open] summary::after { transform: rotate(-135deg) translateY(-3px); }
  details p { padding-bottom: var(--space-6); color: var(--ink-muted); max-width: var(--measure); }
</style>
